# ── Database ──────────────────────────────────────────────
# Local dev: `npm run db:local` starts PostgreSQL on 54329.
DATABASE_URL="postgresql://moai:moai-local-dev-only@localhost:54329/moai"

# ── Security ──────────────────────────────────────────────
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts integration secrets and TOTP secrets at rest. Losing it = re-entering credentials.
APP_ENCRYPTION_KEY=""
# Optional previous key during rotation (decrypt-only)
APP_ENCRYPTION_KEY_PREVIOUS=""
# Public URL of the app (used for cookies, webhook URLs)
APP_URL="http://localhost:3000"

# ── Demo mode ─────────────────────────────────────────────
# When "true" the UI shows a DEMO banner. Demo data is created only by `npm run db:seed-demo`.
DEMO_MODE="false"

# ── Storage (private documents: XML invoices, CSV imports) ─
# local: files under STORAGE_LOCAL_DIR (dev only). In production mount an encrypted EU volume
# or replace src/server/storage.ts with an S3-compatible EU bucket implementation.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# ── Shopify ───────────────────────────────────────────────
# Credentials are NOT configured here: they are entered in Integrations → Shopify and stored encrypted.
SHOPIFY_API_VERSION="2026-10"

# ── Worker ────────────────────────────────────────────────
WORKER_POLL_MS="3000"
WORKER_SCHEDULE_MINUTES="15"

# ── Dev convenience ───────────────────────────────────────
# Run the job worker inside the Next.js process (dev/single VM). In production use `npm run worker`.
INLINE_WORKER="true"
