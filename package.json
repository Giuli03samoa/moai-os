{
  "name": "moai-os",
  "version": "1.0.0-mvp",
  "private": true,
  "description": "MOAI OS — piattaforma gestionale proprietaria MOAI Athletics (Shopify, Aruba, pagamenti, Packlink PRO)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "worker": "tsx src/server/jobs/worker-main.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:demo-delete": "tsx scripts/delete-demo.ts",
    "agent:smoke": "tsx scripts/agent-tools-smoke.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "service:install": "tsx scripts/service/install.ts",
    "service:uninstall": "tsx scripts/service/install.ts --uninstall",
    "service:status": "tsx scripts/service/status.ts",
    "service:restart": "launchctl kickstart -k gui/$(id -u)/it.moaiathletics.os.app",
    "backup:now": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/restore-backup.ts --verify",
    "backup:extract": "tsx scripts/restore-backup.ts --extract",
    "desktop:build": "bash desktop/build.sh",
    "desktop:icons": "python3 desktop/make-icons.py && iconutil -c icns desktop/AppIcon.iconset -o desktop/AppIcon.icns"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@date-fns/tz": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "fast-xml-parser": "^5.11.2",
    "geist": "^1.8.1",
    "imapflow": "2.8.0",
    "lucide-react": "^1.58.0",
    "mailparser": "3.12.2",
    "next": "^15.5.28",
    "nodemailer": "^7.0.13",
    "otpauth": "^9.5.2",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mailparser": "3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^17.10.0-beta.17",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@17.10.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "fsevents@2.3.3": true
  }
}
